{
  "name": "fiber-test-lab",
  "version": "0.9.1",
  "type": "module",
  "description": "Fully-local, one-command test environment for Fiber Network payment/routing scenarios (CLI + YAML scenarios + test-kit).",
  "keywords": [
    "fiber-network",
    "ckb",
    "nervos",
    "payment-channel",
    "lightning",
    "testing",
    "docker",
    "cli"
  ],
  "homepage": "https://github.com/nhkhanq/fiber-test-lab#readme",
  "bugs": {
    "url": "https://github.com/nhkhanq/fiber-test-lab/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhkhanq/fiber-test-lab.git"
  },
  "license": "MIT",
  "author": "nhkhanq",
  "engines": {
    "node": ">=20.6"
  },
  "bin": {
    "fiber-lab": "bin/fiber-lab.mjs"
  },
  "exports": {
    "./test-kit": {
      "types": "./types/test-kit/index.d.ts",
      "default": "./test-kit/entry.mjs"
    },
    "./report": {
      "types": "./types/lib/report/index.d.ts",
      "default": "./lib/report/entry.mjs"
    }
  },
  "files": [
    "CHANGELOG.md",
    "bin",
    "types",
    "cli",
    "lib",
    "test-kit",
    "topology/docker",
    "topology/scenarios",
    "topology/compose.template.ts",
    "fiber-lab.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "prepare": "node scripts/build-types.mjs",
    "prepublishOnly": "tsx scripts/release-check.ts",
    "lab": "tsx cli/index.ts",
    "ui": "tsx cli/index.ts ui --open",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit/ test/report.test.ts test/shebang.test.ts",
    "test:consumer": "node scripts/check-consumer.mjs",
    "test:integration": "vitest run test/ test-kit/examples/ --exclude \"test/unit/**\" --exclude test/report.test.ts --exclude test/shebang.test.ts"
  },
  "dependencies": {
    "@ckb-ccc/core": "0.0.0-canary-20260330023358",
    "@ckb-ccc/fiber": "0.0.0-canary-20260330023358",
    "commander": "^12.1.0",
    "tsx": "^4.23.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
